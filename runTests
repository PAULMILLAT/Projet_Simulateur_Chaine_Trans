#!/bin/sh
# Script d'autotests pour l'Etape 1 du projet SIT213
# L'appel des tests Java a été écrit à la main par Yann
# Les tests en bash (bonus non demandés) sont générés à l'aide de l'IA copilot.
# @ author Yann
# @ author copilot

PATH="/usr/bin:/bin:$PATH"

# Verifier et compiler automatiquement si les classes ne sont pas presentes
if [ ! -f bin/tests/TestSimulateur.class ] || [ ! -f bin/simulateur/Simulateur.class ]; then
    echo "Compilation prealable du projet..."
    sh ./compile
    if [ $? -ne 0 ]; then
        echo "Echec de la compilation prealable !"
        exit 1
    fi
    echo ""
fi

echo "=== Lancement des tests SIT213 - Etapes 1, 2, 3, 4 & 5 ==="
echo "========================================="
echo "1. Lancement de la suite de tests Java"
echo "========================================="

java -cp bin TestSimulateur
STATUT_JAVA=$?

if [ $STATUT_JAVA -ne 0 ]; then
    echo "Echec des tests unitaires Java !"
    exit $STATUT_JAVA
fi

echo ""
echo "========================================="
echo "2. Lancement des tests JUnit (trajets multiples / sondage)"
echo "========================================="

JUNIT_JAR=$(ls lib/junit-platform-console-standalone*.jar 2>/dev/null | head -n 1)
if [ -z "$JUNIT_JAR" ]; then
    echo "JUnit introuvable (aucun lib/junit-platform-console-standalone*.jar) : tests JUnit ignores."
    echo "-> A telecharger (org.junit.platform:junit-platform-console-standalone"
    echo "   sur Maven Central) et a placer dans lib/ pour activer cette etape."
else
    # Les classes ont deja ete compilees dans bin/ par le script compile.
    # Le ConsoleLauncher scanne bin/ et execute tous les tests JUnit.
    java -jar "$JUNIT_JAR" execute \
        --class-path "bin" \
        --scan-class-path "bin" \
        --disable-banner
    STATUT_JUNIT=$?

    if [ $STATUT_JUNIT -ne 0 ]; then
        echo "Echec des tests JUnit !"
        exit $STATUT_JUNIT
    fi
fi

echo ""
echo "========================================="
echo "3. Lancement des tests d'integration CLI "
echo "========================================="

NB_TESTS=0
NB_SUCCES=0
NB_ECHECS=0

run_test_succes() {
    NB_TESTS=$((NB_TESTS + 1))
    desc="$1"
    shift
    printf "Test %d: %-55s ... " "$NB_TESTS" "$desc"
    output=$(sh ./simulateur "$@" 2>&1)
    status=$?
    if [ $status -eq 0 ] && echo "$output" | grep -q "TEB : 0\.0"; then
        echo "OK"
        NB_SUCCES=$((NB_SUCCES + 1))
    else
        echo "ECHEC (code=$status, sortie='$output')"
        NB_ECHECS=$((NB_ECHECS + 1))
    fi
}

run_test_erreur() {
    NB_TESTS=$((NB_TESTS + 1))
    desc="$1"
    shift
    printf "Test %d: %-55s ... " "$NB_TESTS" "$desc"
    output=$(sh ./simulateur "$@" 2>&1)
    status=$?
    if [ $status -ne 0 ]; then
        echo "OK (erreur attendue detectee)"
        NB_SUCCES=$((NB_SUCCES + 1))
    else
        echo "ECHEC (une erreur etait attendue, sortie='$output')"
        NB_ECHECS=$((NB_ECHECS + 1))
    fi
}

run_test_teb_valide() {
    NB_TESTS=$((NB_TESTS + 1))
    desc="$1"
    shift
    printf "Test %d: %-55s ... " "$NB_TESTS" "$desc"
    output=$(sh ./simulateur "$@" 2>&1)
    status=$?
    if [ $status -eq 0 ] && echo "$output" | grep -q "TEB : [0-9]"; then
        echo "OK"
        NB_SUCCES=$((NB_SUCCES + 1))
    else
        echo "ECHEC (code=$status, sortie='$output')"
        NB_ECHECS=$((NB_ECHECS + 1))
    fi
}

# 1. Tests nominaux (chaine logique parfaite => TEB attendu = 0.0)
# --- Tests TP1 : Chaine logique ---
echo "--- Tests TP1 : Chaine logique ---"
run_test_succes "Execution par defaut (100 bits aleatoires)"
run_test_succes "Message fixe 8 bits" -mess 01010101
run_test_succes "Message fixe 16 bits" -mess 1100101011110000
run_test_succes "Message aleatoire de 50 bits" -mess 50
run_test_succes "Message aleatoire de 500 bits" -mess 500
run_test_succes "Message aleatoire avec germe (-seed 42)" -mess 100 -seed 42
run_test_succes "Message aleatoire avec germe (-seed 12345)" -seed 12345

# 2. Tests de robustesse (arguments invalides attendus en echec)
# --- Tests TP2 : Chaine analogique ---
echo ""
echo "--- Tests TP2 : Chaine analogique ---"
run_test_succes "Transmission NRZ (-form NRZ)" -form NRZ
run_test_succes "Transmission RZ explicite (-form RZ)" -form RZ
run_test_succes "Transmission NRZT (-form NRZT -ampl -5.0 5.0)" -form NRZT -ampl -5.0 5.0
run_test_succes "Transmission analogique par defaut RZ (-nbEch 45)" -nbEch 45
run_test_succes "Transmission NRZ avec nbEch=60 et message fixe" -form NRZ -nbEch 60 -mess 0101010101

# --- Tests TP3 : Chaine analogique bruitee ---
echo ""
echo "--- Tests TP3 : Chaine analogique bruitee ---"
run_test_succes "Transmission bruitee fort SNR 30dB (TEB = 0.0)" -form NRZ -snrpb 30
run_test_succes "Transmission bruitee fort SNR 30dB avec alias -snr" -form NRZ -snr 30
run_test_teb_valide "Transmission bruitee SNR 5dB (-snrpb 5)" -form NRZ -snrpb 5
run_test_teb_valide "Transmission bruitee avec germe (-snrpb 0 -seed 42)" -form NRZ -snrpb 0 -seed 42
run_test_teb_valide "Transmission bruitee RZ (-form RZ -snrpb 10)" -form RZ -snrpb 10
run_test_teb_valide "Transmission bruitee NRZT (-form NRZT -ampl -5.0 5.0 -snrpb 10)" -form NRZT -ampl -5.0 5.0 -snrpb 10

# --- Tests TP4 : Chaine analogique multi-trajets (-ti) ---
echo ""
echo "--- Tests TP4 : Chaine analogique multi-trajets (-ti) ---"
run_test_teb_valide "Transmission multi-trajets 1 trajet (-ti 30 0.5)" -ti 30 0.5
run_test_teb_valide "Transmission multi-trajets 2 trajets (-ti 30 0.4 60 -0.2)" -ti 30 0.4 60 -0.2
run_test_teb_valide "Transmission multi-trajets bruitee (-ti 30 0.3 -snrpb 10)" -ti 30 0.3 -snrpb 10
run_test_succes "Transmission multi-trajets avec sondage (-ti 60 0.5 -sondage)" -mess 3000 -form RZ -nbEch 30 -ti 60 0.5 -sondage

# --- Tests TP5 : Codage de canal (-codeur) ---
echo ""
echo "--- Tests TP5 : Codage de canal (-codeur) ---"
run_test_succes "Transmission logique avec codage (-codeur)" -codeur
run_test_succes "Transmission logique message fixe avec codage" -mess 01010101 -codeur
run_test_succes "Transmission analogique NRZ avec codage" -mess 500 -form NRZ -codeur
run_test_succes "Transmission analogique RZ avec codage" -mess 500 -form RZ -codeur
run_test_succes "Transmission analogique NRZT avec codage" -mess 500 -form NRZT -ampl -5.0 5.0 -codeur
run_test_teb_valide "Transmission bruitee NRZ avec codage (-snrpb 5 -codeur)" -form NRZ -snrpb 5 -codeur
run_test_teb_valide "Transmission bruitee RZ avec codage (-snrpb 10 -codeur)" -form RZ -snrpb 10 -codeur
run_test_succes "Transmission multi-trajets sondage et codage (-ti 60 0.5 -sondage -codeur)" -mess 3000 -form RZ -nbEch 30 -ti 60 0.5 -sondage -codeur

# --- Tests de robustesse et contraintes ---
echo ""
echo "--- Tests de robustesse & rejets d'arguments ---"
run_test_erreur "Argument option inconnue" -invalide
run_test_erreur "Longueur de message nulle (-mess 0)" -mess 0
run_test_erreur "Germe non numerique (-seed abc)" -seed abc
run_test_erreur "Format message invalide (-mess abc)" -mess abc
run_test_erreur "Rejet RZ avec min != 0 (-form RZ -ampl -5.0 5.0)" -form RZ -ampl -5.0 5.0
run_test_erreur "Rejet NRZ avec min > 0 (-form NRZ -ampl 1.0 5.0)" -form NRZ -ampl 1.0 5.0
run_test_erreur "Rejet min >= max (-form NRZ -ampl 5.0 1.0)" -form NRZ -ampl 5.0 1.0
run_test_erreur "Rejet nbEch <= 0 (-nbEch 0)" -nbEch 0
run_test_erreur "Rejet forme d'onde inconnue (-form TOTO)" -form TOTO
run_test_erreur "Rejet -snrpb sans valeur (-snrpb)" -snrpb
run_test_erreur "Rejet -snrpb non numerique (-snrpb abc)" -snrpb abc
run_test_erreur "Rejet -snr sans valeur (-snr)" -snr
run_test_erreur "Rejet -snr non numerique (-snr xyz)" -snr xyz
run_test_erreur "Rejet -ti sans parametre (-ti)" -ti
run_test_erreur "Rejet -ti couple incomplet (-ti 10)" -ti 10
run_test_erreur "Rejet -ti dt non entier (-ti abc 0.5)" -ti abc 0.5
run_test_erreur "Rejet -ti ar non flottant (-ti 10 xyz)" -ti 10 xyz
run_test_erreur "Rejet -ti plus de 5 trajets" -ti 10 0.1 20 0.1 30 0.1 40 0.1 50 0.1 60 0.1
run_test_erreur "Rejet -ti dt negatif (-ti -10 0.5)" -ti -10 0.5

echo ""
echo "=== Bilan des tests CLI : $NB_SUCCES/$NB_TESTS reussis ($NB_ECHECS echecs) ==="

if [ $NB_ECHECS -eq 0 ]; then
    exit 0
else
    exit 1
fi