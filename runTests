#!/bin/sh
# Script d'autotests pour l'Etape 1 du projet SIT213
# Les tests en bash sont générés à l'aide de copilot.
# L'appel des tests Java a été écrite à la main.
# @ author Yann, IA

PATH="/usr/bin:/bin:$PATH"

# Verifier et compiler automatiquement si les classes ne sont pas presentes
if [ ! -f bin/tests/TestSimulateur.class ] || [ ! -f bin/simulateur/Simulateur.class ]; then
    echo "Compilation prealable du projet..."
    sh ./compile
    if [ $? -ne 0 ]; then
        echo "Echec de la compilation prealable !"
        exit 1
    fi
    echo ""
fi

echo "=== Lancement des tests SIT213 - Etape 1 & 2 ==="
echo "========================================="
echo "1. Lancement de la suite de tests Java"
echo "========================================="

java -cp bin TestSimulateur
STATUT_JAVA=$?

if [ $STATUT_JAVA -ne 0 ]; then
    echo "Echec des tests unitaires Java !"
    exit $STATUT_JAVA
fi

echo ""
echo "========================================="
echo "2. Lancement des tests d'integration CLI "
echo "========================================="

NB_TESTS=0
NB_SUCCES=0
NB_ECHECS=0

run_test_succes() {
    NB_TESTS=$((NB_TESTS + 1))
    desc="$1"
    shift
    printf "Test %d: %-55s ... " "$NB_TESTS" "$desc"
    output=$(sh ./simulateur "$@" 2>&1)
    status=$?
    if [ $status -eq 0 ] && echo "$output" | grep -q "TEB : 0\.0"; then
        echo "OK"
        NB_SUCCES=$((NB_SUCCES + 1))
    else
        echo "ECHEC (code=$status, sortie='$output')"
        NB_ECHECS=$((NB_ECHECS + 1))
    fi
}

run_test_erreur() {
    NB_TESTS=$((NB_TESTS + 1))
    desc="$1"
    shift
    printf "Test %d: %-55s ... " "$NB_TESTS" "$desc"
    output=$(sh ./simulateur "$@" 2>&1)
    status=$?
    if [ $status -ne 0 ]; then
        echo "OK (erreur attendue detectee)"
        NB_SUCCES=$((NB_SUCCES + 1))
    else
        echo "ECHEC (une erreur etait attendue, sortie='$output')"
        NB_ECHECS=$((NB_ECHECS + 1))
    fi
}

# 1. Tests nominaux (chaine logique parfaite => TEB attendu = 0.0)
# --- Tests TP1 : Chaine logique ---
echo "--- Tests TP1 : Chaine logique ---"
run_test_succes "Execution par defaut (100 bits aleatoires)"
run_test_succes "Message fixe 8 bits" -mess 01010101
run_test_succes "Message fixe 16 bits" -mess 1100101011110000
run_test_succes "Message aleatoire de 50 bits" -mess 50
run_test_succes "Message aleatoire de 500 bits" -mess 500
run_test_succes "Message aleatoire avec germe (-seed 42)" -mess 100 -seed 42
run_test_succes "Message aleatoire avec germe (-seed 12345)" -seed 12345

# 2. Tests de robustesse (arguments invalides attendus en echec)
# --- Tests TP2 : Chaine analogique ---
echo ""
echo "--- Tests TP2 : Chaine analogique ---"
run_test_succes "Transmission NRZ (-form NRZ)" -form NRZ
run_test_succes "Transmission RZ explicite (-form RZ)" -form RZ
run_test_succes "Transmission NRZT (-form NRZT -ampl -5.0 5.0)" -form NRZT -ampl -5.0 5.0
run_test_succes "Transmission analogique par defaut RZ (-nbEch 45)" -nbEch 45
run_test_succes "Transmission NRZ avec nbEch=60 et message fixe" -form NRZ -nbEch 60 -mess 0101010101

# --- Tests de robustesse et contraintes ---
echo ""
echo "--- Tests de robustesse & rejets d'arguments ---"
run_test_erreur "Argument option inconnue" -invalide
run_test_erreur "Longueur de message nulle (-mess 0)" -mess 0
run_test_erreur "Germe non numerique (-seed abc)" -seed abc
run_test_erreur "Format message invalide (-mess abc)" -mess abc
run_test_erreur "Rejet RZ avec min != 0 (-form RZ -ampl -5.0 5.0)" -form RZ -ampl -5.0 5.0
run_test_erreur "Rejet NRZ avec min > 0 (-form NRZ -ampl 1.0 5.0)" -form NRZ -ampl 1.0 5.0
run_test_erreur "Rejet min >= max (-form NRZ -ampl 5.0 1.0)" -form NRZ -ampl 5.0 1.0
run_test_erreur "Rejet nbEch <= 0 (-nbEch 0)" -nbEch 0
run_test_erreur "Rejet forme d'onde inconnue (-form TOTO)" -form TOTO

echo ""
echo "=== Bilan des tests CLI : $NB_SUCCES/$NB_TESTS reussis ($NB_ECHECS echecs) ==="

if [ $NB_ECHECS -eq 0 ]; then
    exit 0
else
    exit 1
fi