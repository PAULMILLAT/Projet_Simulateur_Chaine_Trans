#!/bin/sh
# Remet le projet dans un etat "propre" : ni .class, ni javadoc, ni archive.
# ATTENTION : ce script est parfois execute via '. ./cleanAll' (sourcing),
# il ne doit donc surtout PAS contenir de 'exit' qui tuerait le shell appelant.

echo "Nettoyage en cours..."

# On supprime puis on recree les repertoires plutot que de vider leur contenu :
# 'rm -rf bin/*' laisserait passer les fichiers caches (.gitkeep, .DS_Store...)
# que le script de conformite du client compte comme du contenu.
rm -rf bin docs
mkdir -p bin docs

rm -f ./*.tar.gz

# Fichiers temporaires laisses par javac en cas d'echec
rm -f ./javac.*.args

echo "Nettoyage termine : bin/ et docs/ sont vides, archives supprimees."

